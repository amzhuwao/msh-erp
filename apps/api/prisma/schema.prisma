generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Module 18: System Administration ───────────────────────────────────────

model PropertyConfiguration {
  id              String   @id @default(cuid())
  propertyName    String
  address         String
  vatNumber       String?
  primaryCurrency String   @default("USD")
  contactEmail    String?
  contactPhone    String?
  checkInTime     String   @default("14:00")
  checkOutTime    String   @default("10:00")
  logoUrl         String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("property_configuration")
}

model GlobalSetting {
  id             String  @id @default(cuid())
  key            String  @unique
  value          String
  description    String?
  isSystemLocked Boolean @default(false)

  @@map("global_settings")
}

enum DocumentModule {
  RESERVATIONS
  GROUP_RESERVATIONS
  INVOICES
  RECEIPTS
  PO
  GRN
  PAYROLL
}

model DocumentNumberingPattern {
  id              String         @id @default(cuid())
  module          DocumentModule @unique
  prefix          String
  currentSequence Int            @default(1)
  paddingDigits   Int            @default(4)
  suffix          String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@map("document_numbering_patterns")
}

model TaxRateDefinition {
  id          String   @id @default(cuid())
  name        String
  code        String   @unique
  ratePercent Decimal  @db.Decimal(5, 4)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("tax_rate_definitions")
}

// ─── Module 17: User, Role & Access Management ──────────────────────────────

model Department {
  id        String   @id @default(cuid())
  name      String   @unique
  users     User[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("departments")
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  permissions Json
  users       User[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("roles")
}

model User {
  id                    String               @id @default(cuid())
  username              String               @unique
  email                 String               @unique
  passwordHash          String
  fullName              String
  departmentId          String?
  department            Department?          @relation(fields: [departmentId], references: [id])
  roleId                String
  role                  Role                 @relation(fields: [roleId], references: [id])
  isActive              Boolean              @default(true)
  sessionTimeoutMinutes Int                  @default(20)
  lastLoginAt           DateTime?
  mfaSecret             String?
  permissionOverrides   PermissionOverride[]
  reservationsCreated   Reservation[]        @relation("ReservationCreatedBy")
  groupReservationsCreated GroupReservation[] @relation("GroupReservationCreatedBy")
  statusChanges         ReservationStatusHistory[]
  auditLogs             AuditLog[]
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  @@index([roleId])
  @@index([departmentId])
  @@map("users")
}

model UserGroup {
  id          String            @id @default(cuid())
  name        String            @unique
  description String?
  members     UserGroupMember[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@map("user_groups")
}

model UserGroupMember {
  userGroupId String
  userId      String
  userGroup   UserGroup @relation(fields: [userGroupId], references: [id], onDelete: Cascade)
  assignedAt  DateTime  @default(now())

  @@id([userGroupId, userId])
  @@map("user_group_members")
}

model PermissionOverride {
  id        String  @id @default(cuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  module    String
  action    String
  isAllowed Boolean

  @@unique([userId, module, action])
  @@map("permission_overrides")
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  module     String
  action     String
  entityType String?
  entityId   String?
  details    Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([module, action])
  @@index([createdAt])
  @@map("audit_logs")
}

// ─── Module 3: Housekeeping / Rooms ─────────────────────────────────────────

enum RoomStatus {
  OCCUPIED
  OCCUPIED_DIRTY
  VACANT_DIRTY
  CLEANING_IN_PROGRESS
  VACANT_CLEAN
  INSPECTED
  OUT_OF_ORDER
  OUT_OF_SERVICE
  MAINTENANCE
}

model RoomType {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String?
  maxAdults   Int      @default(2)
  maxChildren Int      @default(1)
  baseRate    Decimal  @db.Decimal(10, 2)
  rooms       Room[]
  ratePlans   RatePlan[]
  groupRooms  GroupRoom[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("room_types")
}

enum AssignmentStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

model HousekeepingAssignment {
  id                String           @id @default(cuid())
  date              DateTime         @db.Date
  roomId            String
  room              Room             @relation(fields: [roomId], references: [id])
  attendantUserId   String
  status            AssignmentStatus @default(PENDING)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@unique([date, roomId])
  @@index([attendantUserId])
  @@map("housekeeping_assignments")
}

model Room {
  id           String        @id @default(cuid())
  number       String        @unique
  floor        Int
  roomTypeId   String
  roomType     RoomType      @relation(fields: [roomTypeId], references: [id])
  status       RoomStatus    @default(INSPECTED)
  isActive     Boolean       @default(true)
  reservations Reservation[]
  groupRooms   GroupRoom[]
  assignments  HousekeepingAssignment[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([roomTypeId])
  @@index([status])
  @@map("rooms")
}

// ─── Module 14: Revenue Management (starter) ────────────────────────────────

model RatePlan {
  id         String        @id @default(cuid())
  code       String        @unique
  name       String
  roomTypeId String
  roomType   RoomType      @relation(fields: [roomTypeId], references: [id])
  baseRate   Decimal       @db.Decimal(10, 2)
  isActive   Boolean       @default(true)
  reservations Reservation[]
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@index([roomTypeId])
  @@map("rate_plans")
}

// ─── Module 1: Reservations & Front Office ──────────────────────────────────

enum ReservationStatus {
  TENTATIVE
  CONFIRMED
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
  NO_SHOW
}

enum VipStatus {
  NONE
  VIP1
  VIP2
  VIP3
}

model Guest {
  id             String        @id @default(cuid())
  firstName      String
  lastName       String
  email          String        @unique
  phone          String?
  nationality    String?
  nationalId     String?
  passportNumber String?
  vipStatus      VipStatus     @default(NONE)
  notes          String?
  reservations   Reservation[]
  folios         Folio[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@map("guests")
}

model Reservation {
  id                String                     @id @default(cuid())
  reservationNumber String                     @unique
  guestId           String
  guest             Guest                      @relation(fields: [guestId], references: [id])
  ratePlanId        String
  ratePlan          RatePlan                   @relation(fields: [ratePlanId], references: [id])
  roomId            String?
  room              Room?                      @relation(fields: [roomId], references: [id])
  checkInDate       DateTime                   @db.Date
  checkOutDate      DateTime                   @db.Date
  adults            Int                        @default(1)
  children          Int                        @default(0)
  status            ReservationStatus          @default(TENTATIVE)
  specialRequests   String?
  cancellationReason String?
  groupReservationId String?
  groupReservation   GroupReservation?   @relation(fields: [groupReservationId], references: [id])
  createdById       String
  createdBy         User                       @relation("ReservationCreatedBy", fields: [createdById], references: [id])
  statusHistory     ReservationStatusHistory[]
  folios            Folio[]
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt

  @@index([guestId])
  @@index([roomId])
  @@index([groupReservationId])
  @@index([status])
  @@index([checkInDate, checkOutDate])
  @@map("reservations")
}

model ReservationStatusHistory {
  id            String            @id @default(cuid())
  reservationId String
  reservation   Reservation       @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  oldStatus     ReservationStatus?
  newStatus     ReservationStatus
  changedById   String
  changedBy     User              @relation(fields: [changedById], references: [id])
  changeReason  String?
  createdAt     DateTime          @default(now())

  @@index([reservationId])
  @@map("reservation_status_history")
}

enum FolioStatus {
  OPEN
  SETTLED
  CLOSED
}

enum FolioLineType {
  CHARGE
  PAYMENT
  ADJUSTMENT
}

model Folio {
  id            String        @id @default(cuid())
  reservationId String
  reservation   Reservation   @relation(fields: [reservationId], references: [id])
  guestId       String
  guest         Guest         @relation(fields: [guestId], references: [id])
  status        FolioStatus   @default(OPEN)
  lines         FolioLine[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([reservationId])
  @@map("folios")
}

model FolioLine {
  id          String        @id @default(cuid())
  folioId     String
  folio       Folio         @relation(fields: [folioId], references: [id], onDelete: Cascade)
  lineType    FolioLineType
  description String
  amount      Decimal       @db.Decimal(10, 2)
  postedById  String?
  createdAt   DateTime      @default(now())

  @@index([folioId])
  @@map("folio_lines")
}

// ─── Module 13: Corporate Clients (starter for groups) ────────────────────────

model CorporateProfile {
  id                 String             @id @default(cuid())
  companyName        String
  registrationNumber String?            @unique
  contactName        String
  contactEmail       String
  phone              String?
  creditLimit        Decimal            @default(0) @db.Decimal(12, 2)
  currentOutstanding Decimal            @default(0) @db.Decimal(12, 2)
  paymentTermsDays   Int                @default(30)
  isCreditApproved   Boolean            @default(false)
  isActive           Boolean            @default(true)
  groupReservations  GroupReservation[]
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@map("corporate_profiles")
}

// ─── Module 2: Group Reservations ───────────────────────────────────────────

enum GroupReservationStatus {
  TENTATIVE
  CONFIRMED
  CLOSED
  CANCELLED
}

enum GroupGuestCheckInStatus {
  PENDING
  CHECKED_IN
  CHECKED_OUT
}

enum GroupRoomAllocationStatus {
  BLOCKED
  ALLOCATED
}

enum GroupChargePaidBy {
  MASTER
  GUEST
  COMPANY
  SPONSOR
}

enum GroupInvoiceStatus {
  UNPAID
  PAID
  PARTIAL
}

model GroupReservation {
  id              String                 @id @default(cuid())
  groupCode       String                 @unique
  companyId       String?
  company         CorporateProfile?      @relation(fields: [companyId], references: [id])
  groupName       String
  contactPerson   String
  phone           String
  email           String
  arrivalDate     DateTime               @db.Date
  departureDate   DateTime               @db.Date
  adults          Int                    @default(1)
  children        Int                    @default(0)
  roomCount       Int
  status          GroupReservationStatus @default(TENTATIVE)
  depositAmount   Decimal                @default(0) @db.Decimal(10, 2)
  balance         Decimal                @default(0) @db.Decimal(10, 2)
  specialRequests String?
  createdById     String
  createdBy       User                   @relation("GroupReservationCreatedBy", fields: [createdById], references: [id])
  guests          GroupGuest[]
  roomAllocations GroupRoom[]
  charges         GroupCharge[]
  invoices        GroupInvoice[]
  reservations    Reservation[]
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  @@index([companyId])
  @@index([status])
  @@index([arrivalDate, departureDate])
  @@map("group_reservations")
}

model GroupGuest {
  id                  String                  @id @default(cuid())
  groupReservationId  String
  groupReservation    GroupReservation        @relation(fields: [groupReservationId], references: [id], onDelete: Cascade)
  reservationId       String?                 @unique
  fullName            String
  nationality         String?
  nationalId          String?
  passportNumber      String?
  roomTypeCode        String?
  roomNumber          String?
  vipStatus           VipStatus               @default(NONE)
  notes               String?
  checkInStatus       GroupGuestCheckInStatus @default(PENDING)
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt

  @@index([groupReservationId])
  @@map("group_guests")
}

model GroupRoom {
  id                 String                    @id @default(cuid())
  groupReservationId String
  groupReservation   GroupReservation          @relation(fields: [groupReservationId], references: [id], onDelete: Cascade)
  roomId             String
  room               Room                      @relation(fields: [roomId], references: [id])
  roomTypeId         String
  roomType           RoomType                  @relation(fields: [roomTypeId], references: [id])
  rate               Decimal                   @db.Decimal(10, 2)
  status             GroupRoomAllocationStatus @default(BLOCKED)
  assignedGuestName  String?
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt

  @@unique([groupReservationId, roomId])
  @@index([groupReservationId])
  @@map("group_rooms")
}

model GroupCharge {
  id                 String            @id @default(cuid())
  groupReservationId String
  groupReservation   GroupReservation  @relation(fields: [groupReservationId], references: [id], onDelete: Cascade)
  guestId            String?
  chargeType         String
  amount             Decimal           @db.Decimal(10, 2)
  paidBy             GroupChargePaidBy @default(MASTER)
  chargeDate         DateTime          @db.Date
  createdAt          DateTime          @default(now())

  @@index([groupReservationId])
  @@map("group_charges")
}

model GroupInvoice {
  id                 String             @id @default(cuid())
  groupReservationId String
  groupReservation   GroupReservation   @relation(fields: [groupReservationId], references: [id], onDelete: Cascade)
  invoiceType        String
  amount             Decimal            @db.Decimal(10, 2)
  outstanding        Decimal            @db.Decimal(10, 2)
  status             GroupInvoiceStatus @default(UNPAID)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([groupReservationId])
  @@map("group_invoices")
}
