# Copy to apps/api/.env on the droplet and fill in real values.
# Never commit real secrets.

NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# PostgreSQL (matches docker-compose defaults)
DATABASE_URL=postgresql://msh_erp:changeme@127.0.0.1:5432/msh_erp?schema=public

# Used by docker-compose for the postgres service
POSTGRES_PASSWORD=changeme
