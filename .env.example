# Copy to apps/api/.env on the droplet and fill in real values.
# Never commit real secrets.

NODE_ENV=development
PORT=3000
HOST=0.0.0.0
JWT_SECRET=change-this-in-production
JWT_EXPIRES_IN=8h

# PostgreSQL (matches docker-compose defaults)
DATABASE_URL=postgresql://msh_erp:changeme@127.0.0.1:5432/msh_erp?schema=public

# Optional SMTP for reception online-booking alerts
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=noreply@manicaskyview.co.zw
# SMTP_SECURE=false
